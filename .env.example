# Copia este archivo como ".env" y ajusta los valores.

# Puerto donde corre el servidor
PORT=3000

# Tema (topic) de ntfy donde llegan tus notificaciones.
# Usa algo largo y difícil de adivinar: quien conozca el tema puede leer los avisos.
NTFY_TOPIC=cambia-esto-por-algo-largo-y-secreto-8f3k2

# Servidor ntfy (opcional). Por defecto se usa el público: https://ntfy.sh
# NTFY_SERVER=https://ntfy.sh
